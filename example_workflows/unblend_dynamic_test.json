model for detection,\nand `pip install dghs-imgutils dghs-realutils`. No other custom packs.\nSet the checkpoint at top-left and edit the Scene Book path if needed."],"color":"#432","bgcolor":"#653"}],"links":[[1991,700,0,571,0,"IMAGE"],[2113,1,0,602,0,"MODEL"],[2114,1,1,602,1,"CLIP"],[2116,1,2,602,3,"VAE"],[2121,602,1,575,0,"IMAGE"],[2122,602,2,576,0,"STRING"],[2127,602,0,604,0,"IMAGE"],[2133,605,6,564,1,"BOOLEAN"],[2134,605,7,607,0,"STRING"],[2143,611,1,612,0,"STRING"],[2154,564,5,602,2,"LATENT"],[2155,605,3,602,6,"STRING"],[2158,12,0,616,1,"INT"],[2159,611,0,616,0,"INT"],[2160,616,0,605,1,"INT"],[2161,602,0,700,0,"IMAGE"],[2170,605,2,602,4,"STRING"]],"groups":[{"id":16,"title":"Preview","bounding":[442.3662634794317,86.3269586153703,785.6659999999996,711.6767856908687],"color":"#3f789e","flags":{}},{"id":18,"title":"Scene searcher","bounding":[-876.3191284214205,83.38253813553746,421.3138552148099,653.7801116155781],"color":"#3f789e","flags":{}}],"definitions":{"subgraphs":[{"id":"e2e39cb5-1c9d-4297-abed-d5f181ed1e04","version":1,"state":{"lastGroupId":18,"lastNodeId":616,"lastLinkId":2163,"lastRerouteId":5},"revision":0,"config":{},"name":"Resolution","inputNode":{"id":-10,"bounding":[700.2176425382611,-2024.6827089184437,128,88]},"outputNode":{"id":-20,"bounding":[2534.4188944138264,-2056.881848431933,213.802734375,168]},"inputs":[{"id":"8e122653-8e87-4661-bb63-f2466dba6b47","name":"batch_size","type":"INT","linkIds":[189,190,191,194,1065],"label":"batch_size","pos":[804.2176425382611,-2000.6827089184437]},{"id":"6a6a3b11-d92e-4ce1-8ecc-a67744ee6ec3","name":"switch","type":"BOOLEAN","linkIds":[2132],"label":"horizontal?","pos":[804.2176425382611,-1980.6827089184437]}],"outputs":[{"id":"d2cb686a-b2e9-4e12-8e20-2e90cd1761a2","name":"LATENT","type":"LATENT","linkIds":[1059],"localized_name":"LATENT","label":"Establishing 1280 × 720","pos":[2558.4188944138264,-2032.8818484319331]},{"id":"8a7c4a11-f900-446c-aad6-b95bd220bf31","name":"LATENT_1","type":"LATENT","linkI